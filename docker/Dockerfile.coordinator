FROM golang:1.27.3-alpine AS builder

RUN apk add --no-cache protobuf
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2 \
    && protoc \
        --go_out=. --go_opt=module=github.com/smshagor-dev/ZeroTrust-FL-Sim \
        --go-grpc_out=. --go-grpc_opt=module=github.com/smshagor-dev/ZeroTrust-FL-Sim \
        proto/fl_service.proto \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/coordinator ./cmd/coordinator \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/certgen ./security

FROM golang:1.27.3-alpine AS health-probe-builder
# Build a pinned probe release with explicitly patched transitive dependencies.
# Plain go install pkg@version ignores overrides in the current module.
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.60
WORKDIR /health-probe
RUN go mod init github.com/smshagor-dev/ZeroTrust-FL-Sim/probe-build \
    && go get github.com/grpc-ecosystem/grpc-health-probe@${GRPC_HEALTH_PROBE_VERSION} \
    && go get github.com/go-jose/go-jose/v4@v4.1.6 golang.org/x/net@v0.62.0 \
    && CGO_ENABLED=0 go build -trimpath -o /go/bin/grpc-health-probe github.com/grpc-ecosystem/grpc-health-probe

FROM alpine:3.24 AS runtime

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 ztfl \
    && adduser -S -D -H -u 10001 -G ztfl ztfl \
    && mkdir -p /var/lib/zerotrust-fl \
    && chown -R 10001:10001 /var/lib/zerotrust-fl

COPY --from=builder /out/coordinator /usr/local/bin/coordinator
COPY --from=builder /out/certgen /usr/local/bin/certgen
COPY --from=health-probe-builder /go/bin/grpc-health-probe /usr/local/bin/grpc_health_probe
COPY docker/generate-dev-pki.sh /usr/local/bin/generate-dev-pki.sh
RUN chmod 0555 /usr/local/bin/generate-dev-pki.sh

USER 10001:10001
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/coordinator"]
