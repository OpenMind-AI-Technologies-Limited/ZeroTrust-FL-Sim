# Test-only S3 fixture, built directly from an immutable upstream MinIO release.
# Avoids deleted Docker Hub/quay.io tags and unaudited third-party mirrors.
# Source: https://github.com/minio/minio/releases/tag/RELEASE.2025-09-07T16-13-09Z
# Upstream source is AGPLv3; this is not a production image.
FROM golang:1.27.3-alpine AS builder

ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_SOURCE_SHA=07c3a429bfed433e49018cb0f78a52145d4bedeb

RUN apk add --no-cache git
WORKDIR /src
RUN git init \
    && git remote add origin https://github.com/minio/minio.git \
    && git fetch --no-tags --depth 1 origin "refs/tags/${MINIO_RELEASE}" \
    && test "$(git rev-parse FETCH_HEAD^{commit})" = "${MINIO_SOURCE_SHA}" \
    && git checkout --detach "${MINIO_SOURCE_SHA}"
RUN CGO_ENABLED=0 go build -trimpath -o /out/minio .

FROM alpine:3.24
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 minio-ci \
    && adduser -S -D -H -u 10001 -G minio-ci minio-ci \
    && mkdir /data \
    && chown 10001:10001 /data
COPY --from=builder /out/minio /usr/local/bin/minio
USER 10001:10001
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/minio"]
